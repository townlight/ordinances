# Copy to .env before running docker compose if you need to override defaults.
# Defaults are local-demo only. Do not reuse this password for shared systems.
POSTGRES_DB=townlight_code
POSTGRES_USER=townlight_code
POSTGRES_PASSWORD=townlight_code-local-only
TOWNLIGHT_CODE_PORT=8000
DATABASE_URL=postgresql+psycopg2://townlight_code:townlight_code-local-only@postgres:5432/townlight_code
TOWNLIGHT_CODE_SOURCE_REGISTRY_DB_URL=postgresql+psycopg2://townlight_code:townlight_code-local-only@postgres:5432/townlight_code
TOWNLIGHT_CODE_DEMO_SEED=1
TOWNLIGHT_CODE_DEMO_ACTOR=demo-seed@portland.example.gov
TOWNLIGHT_CODE_STAFF_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
